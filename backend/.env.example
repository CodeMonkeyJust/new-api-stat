# 后端环境变量模板（不含真实凭据）
# 使用方法：在 backend 目录下复制为 .env 并按需修改；.env 已被 .gitignore 忽略，不会上传。
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# 生效条件：在 backend 目录内启动应用，application.yml 通过
#   spring.config.import: optional:file:.env[.properties]
# 自动读取 .env。系统环境变量/部署平台 Secret 优先级高于 .env。
# 格式说明：# 开头为注释；值不要加引号；DB_USERNAME 与 DB_PASSWORD 必须填写真实值。

# ==================== 数据库：PostgreSQL 与 MySQL 二选一 ====================
# 驱动与 Hibernate 方言会按 DB_URL 自动探测，无需额外配置。
# DB_CONNECTION_INIT_SQL 是每个连接建立后执行的初始化 SQL，用于统一
# created_at(epoch 秒) 的统计时区口径；两种数据库语法不同，切换时需同步修改。

# ---- 方式一：PostgreSQL（默认，与 DB_CONNECTION_INIT_SQL 一起使用） ----
DB_URL=jdbc:postgresql://127.0.0.1:5432/new-api
DB_USERNAME=newapi_stat_readonly
DB_PASSWORD=REPLACE_WITH_REAL_PASSWORD
DB_CONNECTION_INIT_SQL=SET TIME ZONE 'Asia/Shanghai'

# ---- 方式二：MySQL（取消注释并填好真实值，同时注释掉方式一） ----
# 提示：MySQL 的 SET time_zone 应使用固定偏移（Asia/Shanghai 对应 '+08:00'）；
# 使用命名时区要求服务器已加载 mysql 时区表，一般不推荐。
# DB_URL=jdbc:mysql://127.0.0.1:3306/new_api?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
# DB_USERNAME=newapi_stat_readonly
# DB_PASSWORD=REPLACE_WITH_REAL_PASSWORD
# DB_CONNECTION_INIT_SQL=SET time_zone = '+08:00'

# 统计日期/小时使用的时区，需与 new-api 库 created_at 口径一致（MySQL 方式下
# 还需与 DB_CONNECTION_INIT_SQL 的偏移量一致）
APP_TIME_ZONE=Asia/Shanghai

# 允许访问统计 API 的 new-api 角色，默认管理员/根用户
APP_ANALYTICS_ROLES=10,100

# 服务端口与上下文路径（修改后需同步前端 VITE_API_BASE_URL 与反向代理）
SERVER_PORT=8082
SERVER_CONTEXT_PATH=/newapi-stat-api

# 允许的跨域来源，逗号分隔；生产环境改为实际前端域名
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Session 会话（HTTPS 部署时把 SESSION_COOKIE_SECURE 设为 true）
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Swagger/OpenAPI（生产环境保持 false）
SWAGGER_ENABLED=false

# 日志级别（可选）
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_APP=INFO