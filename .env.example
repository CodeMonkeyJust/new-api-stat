# =============================================================================
# new-api-stat Docker Compose 部署环境变量模板（不含任何真实密钥）
#
# 用法：复制本文件为 .env 后按需修改（.env 已被 .gitignore 忽略，不会提交）：
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux/macOS:         cp .env.example .env
# 然后执行：docker compose up -d --build
# =============================================================================

# ---- 数据库连接（必填）：指向已有的 new-api 数据库 ----
# 本工具只读复用 new-api 的 logs/users 表，不会建表或改表，建议使用只读账号。
# PostgreSQL 运行在宿主机时（默认示例）：
DB_URL=jdbc:postgresql://host.docker.internal:5432/new-api
# new-api 数据库运行在其它 Docker 网络时：请把 compose.yaml 挂到该网络（见其 networks
# 注释），并把主机名改为对应服务名，例如 jdbc:postgresql://postgres:5432/new-api
# MySQL 示例（取消下一行注释并注释上面的 DB_URL）：
# DB_URL=jdbc:mysql://host.docker.internal:3306/new_api?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true

DB_USERNAME=newapi_stat_readonly
DB_PASSWORD=replace-with-a-secret

# ---- 可选配置（均有默认值，按需取消注释修改）----
# 统计使用的时区（默认 Asia/Shanghai）
# APP_TIME_ZONE=Asia/Shanghai
# 允许访问统计接口的 new-api 角色，默认 10,100（管理员/根用户）
# APP_ANALYTICS_ROLES=10,100
# 后端上下文路径（默认 /newapi-stat-api，一般无需修改）
# SERVER_CONTEXT_PATH=/newapi-stat-api
# 前端对外端口（默认 8080）
# WEB_PORT=8080
# HTTPS 部署时请设为 true（此时需在反向代理层终止 TLS）
# SESSION_COOKIE_SECURE=true
# 前端静态资源 base 路径与 API 前缀（默认与 nginx 配置一致；修改需同步 frontend/nginx.conf）
# VITE_BASE_PATH=/new-api-stat/
# VITE_API_BASE_URL=/newapi-stat-api/api
