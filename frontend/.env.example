# 前端本地环境配置模板（不含任何密钥）
# 使用方法：复制本文件为 .env.local 并按需修改；.env.local 已被 .gitignore 忽略，不会上传。
#   Windows PowerShell:  Copy-Item .env.example .env.local
#   Linux/macOS:         cp .env.example .env.local

# 前端请求后端 API 的基础路径。生产环境通常与后端 SERVER_CONTEXT_PATH 保持一致，
# 由反向代理把该路径转发到后端服务。默认 /new-api-stat-api/api
VITE_API_BASE_URL=/new-api-stat-api/api

# Vite 开发服务器反向代理目标（仅 npm run dev 时生效）。
# 若修改后端 SERVER_CONTEXT_PATH，需同步调整：VITE_API_BASE_URL -> 下方代理前缀 -> 反向代理规则。
VITE_API_PROXY_TARGET=http://localhost:8082

# 前端静态资源部署的 base 路径，默认 /new-api-stat/（如需部署到其它子路径或根路径，构建前修改，如 /stat/ 或 /）
VITE_BASE_PATH=/new-api-stat/

# 开发服务器端口（可选，默认 3001）
# VITE_DEV_PORT=3001